# Prazo em dias para assinatura do termo
PRAZO_DIAS=

# Horário do lembrete diário (formato cron, padrão 9h da manhã)
CRON_LEMBRETE=

# E-mail (SMTP) - exemplo com Gmail (precisa de senha de app)
