# ==============================================================================
# CyberGuard Bot - Environment Variables Template
# Preencha as variáveis abaixo e renomeie este arquivo para .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD CORE CONFIGURATION
# ------------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL) & CRIPTOGRAFIA (LGPD)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/cyberguard_bot
# Chave hexadecimal de 64 caracteres (32 bytes) para criptografia AES-256-GCM de dados sensíveis em repouso
DATA_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. ONBOARDING & RECURSOS HUMANOS (RH)
# ------------------------------------------------------------------------------
CHANNEL_RH_ID=
ROLE_RH_NOME=Recursos Humanos
ROLE_APROVADO_NOME=Membro
ROLE_ENTUSIASTA_NOME=Entusiasta
INVITE_ENTUSIASTA_CODES=
CHANNEL_ENTUSIASTA_ID=
CATEGORIA_ENTUSIASTA_ID=
CHANNEL_BOASVINDAS_ID=
EXPULSAR_AO_REJEITAR=true

# Áreas de interesse selecionáveis no onboarding (separadas por vírgula)
AREAS_INTERESSE=Social Media & Copy,Recursos Humanos,Design,Hardware Hacking,Hacking Ético,Educacional,Desenvolvimento

# Links do WhatsApp (geral e por área específica em formato JSON)
WHATSAPP_LINK=https://chat.whatsapp.com/...
WHATSAPP_LINKS_AREA={"Social Media & Copy":"","Recursos Humanos":"","Design":"","Hardware Hacking":"","Hacking Ético":"","Educacional":"","Desenvolvimento":""}

# IDs específicos de setores (cargos e categorias do Discord)
ROLE_HACKING_ETICO_ID=
CATEGORIA_HACKING_ETICO_ID=
ROLE_EDUCACIONAL_ID=
CATEGORIA_EDUCACIONAL_ID=
ROLE_DESENVOLVIMENTO_ID=
CATEGORIA_DESENVOLVIMENTO_ID=

# ------------------------------------------------------------------------------
# 4. TERMO DE VOLUNTARIADO & GOV.BR
# ------------------------------------------------------------------------------
PRAZO_DIAS=7
CRON_LEMBRETE=0 9 * * *
TEMPLATE_TERMO_PATH=./templates/termo_voluntariado.docx
TUTORIAL_GOVBR_PATH=./docs/tutorial_assinatura_govbr.pdf

# Envio por E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_DESTINATARIOS=
EMAIL_TERMOS_DESTINATARIO=coordenacao@utfpr.edu.br
EMAIL_TERMOS_CC=lider1@alunos.utfpr.edu.br, lider2@alunos.utfpr.edu.br
EMAIL_PROFESSOR_COORDENADOR=coordenador@utfpr.edu.br

# Leitura de E-mails / Retorno de Declarações (IMAP)
# Opcional: por padrão reaproveita SMTP_USER e SMTP_PASS
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# IMAP_TLS=true

# Google Sheets - Espelhamento de Cadastros/Termos
GOOGLE_SHEET_ID=
GOOGLE_SHEET_ABA=Respostas ao formulário 1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Drive - Armazenamento de Documentos em Nuvem
GOOGLE_DRIVE_TERMOS_FOLDER_ID=
GOOGLE_DRIVE_DECLARACOES_FOLDER_ID=

# ------------------------------------------------------------------------------
# 5. SISTEMA DE PONTO ELETRÔNICO v2
# ------------------------------------------------------------------------------
PONTO_ROLE_LIDERES_ID=
PONTO_ROLE_RH_ID=
PONTO_LOG_CHANNEL_ID=
PONTO_RANKING_CHANNEL_ID=
PONTO_VOICE_CHANNEL_ID=
PONTO_MAX_HORAS=8

# Google Sheets - Sincronização de Logs de Ponto
PONTO_SHEET_ID=
PONTO_SHEET_TAB=Raw Logs do Bot

# Importação Legada (KoV Ponto)
KOV_LOG_CHANNEL_ID=
KOV_BOT_ID=

# Notion - Sincronização de Tarefas, Membros e Workspace
NOTION_TOKEN=
NOTION_TOKEN_V2=
NOTION_SPACE_ID=
NOTION_ACTIVE_USER_ID=
NOTION_MEMBROS_DB_ID=
NOTION_DATA_SOURCE_ID=
NOTION_PROP_STATUS=Status
NOTION_PROP_PROGRESSO=Progresso
NOTION_PROP_RESPONSAVEL=Responsável

# ------------------------------------------------------------------------------
# 6. SISTEMA DISCIPLINAR & ADVERTÊNCIAS
# ------------------------------------------------------------------------------
CANAL_ADVERTENCIAS_ID=
AUTORES_ADVERTENCIA_IDS=

# ------------------------------------------------------------------------------
# 7. ATAS DE REUNIÃO COM IA (GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 8. HIERARQUIA VISUAL & ORGANOGRAMA
# ------------------------------------------------------------------------------
HIERARQUIA_CHANNEL_ID=
PRESIDENTE_ID=
VICE_PRESIDENTE_ID=
PURPLE_TEAM_ID=
ROLE_LIDER_NOME=Líderes
ROLE_VICE_LIDER_ID=
ROLE_VICE_LIDER_NOME=Vice-Líder
LIDERES_TIME_JSON={}
